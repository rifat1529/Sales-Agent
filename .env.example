# Ollama model settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
SQL_MODEL=qwen2.5:3b
TEMPERATURE=0.0
TOP_P=0.9
TOP_K=20

# Agent safety limits
MAX_STEPS=8
MAX_TOOL_CALLS=12
TOKEN_BUDGET=6000
MAX_ROWS=200
REQUEST_TIMEOUT=180

# SQLite application-level identity and audit log
DB_PRINCIPAL=agent_readonly
# Optional: AGENT_DB_PATH=E:/path/to/sales.db
# Optional: AUDIT_LOG_PATH=E:/path/to/database_audit.jsonl

# Required application-level password gate for interactive CLI (choose your own secret)
DB_ACCESS_PASSWORD=change_this_to_a_long_random_password
